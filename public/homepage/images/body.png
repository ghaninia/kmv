  <script language="JavaScript" type="text/javascript">
  /*<![CDATA[*/
  $(function(){
    $('#slidedown div:gt(0)').hide();
    setInterval(function(){
      $('#slidedown div:first').fadeOut(1000)
         .next('div').fadeIn(1000)
         .end().appendTo('#slidedown');},
      5000);
});
